    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "@types/node": "^22.20.5",
    "esbuild": "0.25.10",
    "typescript": "5.9.3",
    "wrangler": "^4.165.0"
  },
  "dependencies": {
    "@firebase/app": "0.16.2",
    "@firebase/auth": "1.13.6"
  }
}
