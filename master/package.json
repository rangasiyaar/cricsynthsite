    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts"
  },
  "dependencies": {
    "firebase": "12.19.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251014.0",
    "@types/node": "^22.20.5",
    "esbuild": "0.25.10",
    "typescript": "5.9.3",
    "wrangler": "4.45.0"
  }
}
