# Cloud Run sizing used by every deploy — chosen to stay inside the free tier
# (180,000 vCPU-s + 360,000 GiB-s + 2M requests per month, shared by service and jobs).
REGION=us-central1

# API service: scales to zero, CPU only while handling a request
API_MIN_INSTANCES=0
API_MAX_INSTANCES=2
API_CPU=1
API_MEMORY=512Mi
API_CONCURRENCY=40
API_TIMEOUT=60s

# Batch jobs (ingest, train, simulate): one task at a time, hard time limits
JOB_CPU=2
JOB_MEMORY=4Gi
JOB_TASK_TIMEOUT_INGEST=3600s
JOB_TASK_TIMEOUT_TRAIN=3600s
JOB_TASK_TIMEOUT_SIMULATE=900s
JOB_MAX_RETRIES=0

# BigQuery: cap each query's billed bytes (free tier = 1 TiB/month)
BQ_MAX_BYTES_BILLED=2000000000
