{
  "firestore": {
    "rules": "infra/firestore.rules",
    "indexes": "infra/firestore.indexes.json"
  },
  "hosting": [
    {
      "target": "app",
      "public": "app/out",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": ["firebase.json", "**/.*"],
      "headers": [
        {"source": "**/*.@(js|css|woff2|ttf|png|svg|webp)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
        {"source": "**/*.html", "headers": [{"key": "Cache-Control", "value": "public, max-age=300"}]}
      ]
    },
    {
      "target": "api",
      "public": "infra/api-hosting",
      "rewrites": [{"source": "**", "run": {"serviceId": "cricapi", "region": "us-central1"}}]
    }
  ]
}
