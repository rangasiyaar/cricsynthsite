{
  "firestore": {
    "rules": "infra/firestore.rules",
    "indexes": "infra/firestore.indexes.json"
  },
  "hosting": [
    {
      "target": "app",
      "public": "app/out",
      "cleanUrls": true,
      "trailingSlash": true,
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "headers": [
        {
          "source": "**/*.@(js|css|woff2|ttf|png|svg|webp)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/data/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=600"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=300"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/login.html",
          "destination": "/login/",
          "type": 301
        },
        {
          "source": "/docs.html",
          "destination": "/docs/",
          "type": 301
        },
        {
          "source": "/playground.html",
          "destination": "/playground/",
          "type": 301
        },
        {
          "source": "/mcp.html",
          "destination": "/mcp/",
          "type": 301
        },
        {
          "source": "/careers.html",
          "destination": "/careers/",
          "type": 301
        },
        {
          "source": "/contact.html",
          "destination": "/contact/",
          "type": 301
        },
        {
          "source": "/privacy.html",
          "destination": "/privacy/",
          "type": 301
        },
        {
          "source": "/terms.html",
          "destination": "/terms/",
          "type": 301
        },
        {
          "source": "/index.html",
          "destination": "/",
          "type": 301
        }
      ]
    },
    {
      "target": "api",
      "public": "infra/api-hosting",
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "cricapi",
            "region": "us-central1"
          }
        }
      ]
    }
  ]
}
