     "type": "object",
     "required": false,
     "description": "",
     "default": {}
    },
    {
     "name": "scenario",
     "type": "object",
     "required": false,
     "description": "Pitch, dew, form, start state \u2026 see /v1 catalog"
    },
    {
     "name": "n",
     "type": "integer",
     "required": false,
     "description": "",
     "default": 10000
    },
    {
     "name": "conditions",
     "type": "Condition[]",
     "required": false,
     "description": "",
     "default": [],
     "fields": [
      {
       "name": "type",
